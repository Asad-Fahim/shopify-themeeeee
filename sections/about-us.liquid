  }

  @media (max-width: 640px) {
    #{{ section_id }} .nbd-about__inner {
      width: min(100% - 24px, var(--nbd-max-width));
      padding: 12px 0 clamp(48px, 12vw, 72px);
    }

    #{{ section_id }} .nbd-about__title {
      font-size: clamp(2.55rem, 14vw, 3.9rem);
    }

    #{{ section_id }} h2 {
      font-size: clamp(1.85rem, 9vw, 2.55rem);
    }

    #{{ section_id }} .nbd-about__facts,
