<style>
  #shopify-section-{{ section.id }} {
    --np-dark: #1d302d;
    --np-dark-2: #263d38;
    --np-cream: #f5f1e9;
    --np-gold: #b69a63;
    --np-white: #ffffff;
  }

  #shopify-section-{{ section.id }} .np-section {
    background: {{ section.settings.background }};
    padding: 55px 0;
  }

  #shopify-section-{{ section.id }} .np-header {
    max-width: 700px;
    margin: 0 auto 35px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .np-eyebrow {
    margin: 0 0 10px;
    color: var(--np-gold);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .np-heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .np-grid {
    display: grid;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .np-grid--auto {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  #shopify-section-{{ section.id }} .np-grid--one {
    grid-template-columns: 1fr;
  }

  #shopify-section-{{ section.id }} .np-grid--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #shopify-section-{{ section.id }} .np-grid--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #shopify-section-{{ section.id }} .np-card {
    position: relative;
    min-height: var(--np-height);
    overflow: hidden;
    display: flex;
    align-items: var(--np-vertical);
    background: var(--np-bg);
    color: var(--np-text);
    border: 1px solid rgba(29, 48, 45, 0.12);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #shopify-section-{{ section.id }} .np-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 35px rgba(0, 0, 0, 0.10);
  }

  #shopify-section-{{ section.id }} .np-card--featured {
    grid-column: span 2;
  }

  #shopify-section-{{ section.id }} .np-image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .np-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  #shopify-section-{{ section.id }} .np-card:hover .np-image img {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .np-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--np-overlay);
  }

  #shopify-section-{{ section.id }} .np-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 40px;
  }

  #shopify-section-{{ section.id }} .np-content--left {
    text-align: left;
  }

  #shopify-section-{{ section.id }} .np-content--center {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .np-content--right {
    text-align: right;
  }

  #shopify-section-{{ section.id }} .np-label {
    display: block;
    margin-bottom: 12px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .np-title {
    margin: 0 0 15px;
    color: inherit;
    font-size: clamp(25px, 3vw, 42px);
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .np-description {
    max-width: 560px;
    margin-bottom: 25px;
    font-size: 15px;
    line-height: 1.7;
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .np-content--center .np-description {
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .np-content--right .np-description {
    margin-left: auto;
  }

  #shopify-section-{{ section.id }} .np-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 45px;
    padding: 0 24px;
    background: var(--np-button-bg);
    color: var(--np-button-text);
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: 0.25s ease;
  }

  #shopify-section-{{ section.id }} .np-button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 990px) {
    #shopify-section-{{ section.id }} .np-grid--three {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .np-content {
      padding: 30px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .np-section {
      padding: 40px 0;
    }

    #shopify-section-{{ section.id }} .np-grid,
    #shopify-section-{{ section.id }} .np-grid--two,
    #shopify-section-{{ section.id }} .np-grid--three {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .np-card--featured {
      grid-column: auto;
    }

    #shopify-section-{{ section.id }} .np-card {
      min-height: 300px;
    }

    #shopify-section-{{ section.id }} .np-content {
      padding: 28px 22px;
    }
  }
</style>

<section class="np-section">
  <div class="container">

    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="np-header">

        {% if section.settings.eyebrow != blank %}
          <p class="np-eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="np-heading h2">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

      </div>
    {% endif %}

    <div class="np-grid np-grid--{{ section.settings.layout }}">

      {% for block in section.blocks %}

        {% if block.settings.vertical_position == 'top' %}
          {% assign vertical_position = 'flex-start' %}
        {% elsif block.settings.vertical_position == 'bottom' %}
          {% assign vertical_position = 'flex-end' %}
        {% else %}
          {% assign vertical_position = 'center' %}
        {% endif %}

        <div
          class="np-card {% if block.settings.featured %}np-card--featured{% endif %}"
          style="
            --np-height: {{ block.settings.height }}px;
            --np-bg: {{ block.settings.background }};
            --np-text: {{ block.settings.text_color }};
            --np-button-bg: {{ block.settings.button_background }};
            --np-button-text: {{ block.settings.button_text_color }};
            --np-vertical: {{ vertical_position }};
            --np-overlay: {{ block.settings.overlay_color }};
            --np-overlay-opacity: {{ block.settings.overlay_opacity }};
          "
          {{ block.shopify_attributes }}
        >

          {% if block.settings.style == 'image' and block.settings.image != blank %}
            <div class="np-image">
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '400,600,800,1000,1200,1500,1800',
                  sizes: '(max-width: 749px) 100vw, 50vw'
              }}
            </div>

            <div
              class="np-overlay"
              style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
            ></div>
          {% endif %}

          <div class="np-content np-content--{{ block.settings.text_alignment }}">

            {% if block.settings.label != blank %}
              <span class="np-label">
                {{ block.settings.label | escape }}
              </span>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="np-title">
                {{ block.settings.title | escape }}
              </h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="np-description">
                {{ block.settings.description }}
              </div>
            {% endif %}

            {% if block.settings.button_text != blank and block.settings.button_link != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="np-button"
              >
                {{ block.settings.button_text | escape }}
              </a>
            {% endif %}

          </div>

        </div>

      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Nasir promotional banners",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "DISCOVER MORE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Explore Our Collections"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Banner layout",
      "options": [
        {
          "value": "auto",
          "label": "Automatic"
        },
        {
          "value": "one",
          "label": "One banner per row"
        },
        {
          "value": "two",
          "label": "Two banners per row"
        },
        {
          "value": "three",
          "label": "Three banners per row"
        }
      ],
      "default": "two"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#f5f1e9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1d302d"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Promotional banner",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Banner style",
          "options": [
            {
              "value": "image",
              "label": "Image background"
            },
            {
              "value": "text",
              "label": "Text only"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner image"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Make banner larger",
          "default": false
        },
        {
          "type": "range",
          "id": "height",
          "label": "Banner height",
          "min": 250,
          "max": 650,
          "step": 25,
          "default": 400,
          "unit": "px"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Small label",
          "default": "NASIR BOOK DEPOT"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Discover Your Next Great Read"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Explore our carefully selected collection of books.</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Explore Books"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "vertical_position",
          "label": "Vertical position",
          "options": [
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
          ],
          "default": "center"
        },
        {
          "type": "color",
          "id": "background",
          "label": "Text banner background",
          "default": "#1d302d"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#f5f1e9"
        },
        {
          "type": "color",
          "id": "button_background",
          "label": "Button background",
          "default": "#f5f1e9"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text color",
          "default": "#1d302d"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Image overlay color",
          "default": "#1d302d"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image overlay opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "default": 45,
          "unit": "%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nasir promotional banners",
      "blocks": [
        {
          "type": "banner"
        },
        {
          "type": "banner"
        }
      ]
    }
  ]
}
{% endschema %}